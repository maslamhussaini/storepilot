# ============================================================================
# StorePilot — environment template
# ----------------------------------------------------------------------------
# Copy to `.env.local` and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API), or from the output of
# `supabase start` when developing against a local stack.
#
# `.env*` is gitignored. NEVER commit a file containing real values.
# ============================================================================

# --- Safe to expose to the browser -----------------------------------------
# NEXT_PUBLIC_* variables are inlined into the client bundle by Next.js.
# Only the project URL and the browser-safe key belong here. That key is
# designed to be public: on its own it grants nothing, because every table is
# protected by Row Level Security policies keyed on auth.uid().
#
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is Supabase's current key name
# (Dashboard -> Project Settings -> API -> "Publishable key", an
# `sb_publishable_...` value). Older projects instead issue a legacy anon JWT
# under NEXT_PUBLIC_SUPABASE_ANON_KEY — the app accepts either name, but new
# projects should use the publishable-key name below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=   # legacy fallback name — only if your project issues this instead

# --- SERVER ONLY. NEVER prefix with NEXT_PUBLIC_. --------------------------
# The service-role key BYPASSES Row Level Security completely. Leaking it into
# a client bundle would hand every visitor full read/write access to every
# tenant's data.
#
# Phase 2A does not use this key anywhere in application code — all data access
# runs through the user's own session so that RLS stays in force. It is listed
# here only so future server-only admin tooling (migrations, back-office jobs)
# has a documented home for it. If you ever do use it, import it exclusively in
# a module that carries `import 'server-only'`.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: direct Postgres connection ----------------------------------
# Used only by the RLS test suite (supabase/tests/rls_security_tests.sql) when
# running it against a hosted project via psql. Not read by the application.
SUPABASE_DB_URL=

# ============================================================================
# Shopify — SERVER ONLY. NEVER prefix any of these with NEXT_PUBLIC_.
# ----------------------------------------------------------------------------
# All Shopify configuration is consumed exclusively by server-side Route
# Handlers (src/app/api/shopify/*). The browser never needs any of it — the
# authorize URL is built server-side and the merchant is redirected to it, so
# the client_id/secret never need to reach client JS.
#
# Obtain client_id/client_secret from the Shopify Partner/Dev Dashboard:
# your app -> Client credentials. Never commit real values here.
# ============================================================================
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# This app's own public HTTPS base URL — used to build the OAuth redirect_uri
# and must exactly match a redirect URL registered in the Partner Dashboard.
# Local development: an HTTPS tunnel URL (e.g. a Cloudflare quick tunnel).
SHOPIFY_APP_URL=

# Pinned Admin API version (e.g. "2026-07"). Bumped deliberately, not implicitly.
SHOPIFY_API_VERSION=

# Comma-separated OAuth scopes. Intentionally left empty pending the live
# empty-scope test (see docs/PHASE2B2_PREFLIGHT_REPORT.md §2) — do not default
# this to a non-empty value without recording why.
SHOPIFY_SCOPES=
